<odoo>

    <record id="odoo_school_library_patient_tree" model="ir.ui.view">
        <field name="name">odoo.school.patient.book.tree ()</field>
        <field name="model">odoo_school_library.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="odoo_school_library_patient_form" model="ir.ui.view">
        <field name="name">odoo.school.library.patient.form ()</field>
        <field name="model">odoo_school_library.patient</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_school_library_patient_window" model="ir.actions.act_window">
            <field name="name">Patient</field>
            <field name="res_model">odoo_school_library.patient</field>
            <field name="type">ir.actions.act_window</field>
    </record>

    <menuitem id="odoo_school_library_menu_patient"
          action="action_odoo_school_library_patient_window"
          parent="odoo_school_library_main_menu"
      name="Patient" sequence="200"/>
</odoo>
