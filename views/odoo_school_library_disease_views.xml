<odoo>

    <record id="odoo_school_library_disease_tree" model="ir.ui.view">
        <field name="name">odoo.school.disease.book.tree ()</field>
        <field name="model">odoo_school_library.disease</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name_intended"/>
                <field name="description"/>
                <field name="parent_id"/>
                <field name="complete_name"/>
            </list>
        </field>
    </record>

    <record id="odoo_school_library_disease_form" model="ir.ui.view">
        <field name="name">odoo.school.library.disease.form ()</field>
        <field name="model">odoo_school_library.disease</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="parent_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_school_library_disease_window" model="ir.actions.act_window">
        <field name="name">Disease</field>
        <field name="res_model">odoo_school_library.disease</field>
        <field name="type">ir.actions.act_window</field>
<!--        <field name="view_mode">hierarchy,list,form</field>-->
    </record>

    <menuitem id="odoo_school_library_menu_disease"
          action="action_odoo_school_library_disease_window"
          parent="odoo_school_library_main_menu"
      name="Disease" sequence="200"/>
</odoo>
