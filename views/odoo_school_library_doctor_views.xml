<odoo>

    <record id="odoo_school_library_doctor_tree" model="ir.ui.view">
        <field name="name">odoo.school.doctor.book.tree ()</field>
        <field name="model">odoo_school_library.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="odoo_school_library_doctor_form" model="ir.ui.view">
        <field name="name">odoo.school.library.doctor.form ()</field>
        <field name="model">odoo_school_library.doctor</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_school_library_doctor_window" model="ir.actions.act_window">
            <field name="name">Doctor</field>
            <field name="res_model">odoo_school_library.doctor</field>
            <field name="type">ir.actions.act_window</field>
    </record>

    <menuitem id="odoo_school_library_menu_doctor"
          action="action_odoo_school_library_doctor_window"
          parent="odoo_school_library_main_menu"
      name="Doctor" sequence="200"/>
</odoo>
